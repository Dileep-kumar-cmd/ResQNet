{
  "version": 8,
  "name": "ResQNet CartoDB Dark Navigation",
  "center": [-122.4194, 37.7749],
  "zoom": 12,
  "sources": {
    "carto_dark_tiles": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png",
        "https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png",
        "https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors © CARTO"
    },
    "shelters_source": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      },
      "cluster": true,
      "clusterMaxZoom": 14,
      "clusterRadius": 50
    },
    "hospitals_source": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      },
      "cluster": true,
      "clusterMaxZoom": 14,
      "clusterRadius": 50
    },
    "user_location_source": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "emergency_radius_source": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "carto_dark_base_layer",
      "type": "raster",
      "source": "carto_dark_tiles",
      "minzoom": 0,
      "maxzoom": 19
    },
    {
      "id": "emergency_radius_fill",
      "type": "fill",
      "source": "emergency_radius_source",
      "paint": {
        "fill-color": "#3B82F6",
        "fill-opacity": 0.2
      }
    },
    {
      "id": "emergency_radius_outline",
      "type": "line",
      "source": "emergency_radius_source",
      "paint": {
        "line-color": "#60A5FA",
        "line-width": 2,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "shelter_clusters",
      "type": "circle",
      "source": "shelters_source",
      "filter": ["has", "point_count"],
      "paint": {
        "circle-color": "#2563EB",
        "circle-radius": [
          "step",
          ["get", "point_count"],
          18,
          5,
          24,
          10,
          30
        ],
        "circle-stroke-width": 2,
        "circle-stroke-color": "#93C5FD"
      }
    },
    {
      "id": "shelter_unclustered",
      "type": "circle",
      "source": "shelters_source",
      "filter": ["!", ["has", "point_count"]],
      "paint": {
        "circle-color": "#3B82F6",
        "circle-radius": 12,
        "circle-stroke-width": 2.5,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    {
      "id": "hospital_clusters",
      "type": "circle",
      "source": "hospitals_source",
      "filter": ["has", "point_count"],
      "paint": {
        "circle-color": "#DC2626",
        "circle-radius": [
          "step",
          ["get", "point_count"],
          18,
          5,
          24,
          10,
          30
        ],
        "circle-stroke-width": 2,
        "circle-stroke-color": "#FCA5A5"
      }
    },
    {
      "id": "hospital_unclustered",
      "type": "circle",
      "source": "hospitals_source",
      "filter": ["!", ["has", "point_count"]],
      "paint": {
        "circle-color": "#EF4444",
        "circle-radius": 12,
        "circle-stroke-width": 2.5,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    {
      "id": "user_location_aura",
      "type": "circle",
      "source": "user_location_source",
      "paint": {
        "circle-color": "#10B981",
        "circle-opacity": 0.3,
        "circle-radius": 20
      }
    },
    {
      "id": "user_location_dot",
      "type": "circle",
      "source": "user_location_source",
      "paint": {
        "circle-color": "#10B981",
        "circle-radius": 9,
        "circle-stroke-width": 2.5,
        "circle-stroke-color": "#FFFFFF"
      }
    }
  ]
}
