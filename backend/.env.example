# ResQNet Backend Environment Variables

# Supabase PostgreSQL Connection String:
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format (Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.iljgykyxlnkdvdjgxfyx.supabase.co:5432/postgres
# Format (Connection Pooler - recommended for high concurrency):
# DATABASE_URL=postgresql://postgres.iljgykyxlnkdvdjgxfyx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

DATABASE_URL=sqlite+aiosqlite:///resqnet_server.db

# JWT Secret Key
SECRET_KEY=resqnet_super_secret_jwt_key_2026_offline_first
